/-- Tier 4: the 11 residues of gear 11, each closed by its case. -/
theorem nopair4 {p : ℕ} (e5 : p % 5 = 0) (e7 : p % 7 = 4)
    (hall : ∀ i, i < 95 → (gb5 (p % 5) i || gb7 (p % 7) i || gb11 (p % 11) i || gb13 (p % 13) i || gb17 (p % 17) i || gb19 (p % 19) i || gb23 (p % 23) i || gb29 (p % 29) i || gb31 (p % 31) i || gb37 (p % 37) i) = true) : False := by
  have d11 : p % 11 = 0 ∨ p % 11 = 1 ∨ p % 11 = 2 ∨ p % 11 = 3 ∨ p % 11 = 4 ∨ p % 11 = 5 ∨ p % 11 = 6 ∨ p % 11 = 7 ∨ p % 11 = 8 ∨ p % 11 = 9 ∨ p % 11 = 10 := by omega
  rcases d11 with e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11
  · exact nocase44 e5 e7 e11 hall
  · exact nocase45 e5 e7 e11 hall
  · exact nocase46 e5 e7 e11 hall
  · exact nocase47 e5 e7 e11 hall
  · exact nocase48 e5 e7 e11 hall
  · exact nocase49 e5 e7 e11 hall
  · exact nocase50 e5 e7 e11 hall
  · exact nocase51 e5 e7 e11 hall
  · exact nocase52 e5 e7 e11 hall
  · exact nocase53 e5 e7 e11 hall
  · exact nocase54 e5 e7 e11 hall

