theorem cert180 : MS180_0 + MS180_1 + MS180_2 + MS180_3 + MS180_4 + MS180_5 + MS180_6 + MP180_0 + MP180_1 + MP180_2 + MP180_3 + MP180_4 + MP180_5 + MP180_6 + MP180_7 + MP180_8 + MP180_9 + MP180_10 + MP180_11 + MP180_12 + MP180_13 + MP180_14 + MP180_15 + MP180_16 + MP180_17 + MP180_18 + MP180_19 + MP180_20 < rhs180 := by
  rw [MSv180_0, MSv180_1, MSv180_2, MSv180_3, MSv180_4, MSv180_5, MSv180_6, MPv180_0, MPv180_1, MPv180_2, MPv180_3, MPv180_4, MPv180_5, MPv180_6, MPv180_7, MPv180_8, MPv180_9, MPv180_10, MPv180_11, MPv180_12, MPv180_13, MPv180_14, MPv180_15, MPv180_16, MPv180_17, MPv180_18, MPv180_19, MPv180_20, rhsv180]
  decide

def Dg180 (r0 r1 r2 r3 r4 r5 r6 t : ℕ) : ℤ := (if c180_0 r0 t then 1 else 0) + (if c180_1 r1 t then 1 else 0) + (if c180_2 r2 t then 1 else 0) + (if c180_3 r3 t then 1 else 0) + (if c180_4 r4 t then 1 else 0) + (if c180_5 r5 t then 1 else 0) + (if c180_6 r6 t then 1 else 0)
