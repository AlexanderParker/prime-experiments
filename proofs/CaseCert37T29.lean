/-- Tier 29: the 11 residues of gear 11, each closed by its case. -/
theorem nopair29 {p : ℕ} (e5 : p % 5 = 4) (e7 : p % 7 = 1)
    (hall : ∀ i, i < 95 → (gb5 (p % 5) i || gb7 (p % 7) i || gb11 (p % 11) i || gb13 (p % 13) i || gb17 (p % 17) i || gb19 (p % 19) i || gb23 (p % 23) i || gb29 (p % 29) i || gb31 (p % 31) i || gb37 (p % 37) i) = true) : False := by
  have d11 : p % 11 = 0 ∨ p % 11 = 1 ∨ p % 11 = 2 ∨ p % 11 = 3 ∨ p % 11 = 4 ∨ p % 11 = 5 ∨ p % 11 = 6 ∨ p % 11 = 7 ∨ p % 11 = 8 ∨ p % 11 = 9 ∨ p % 11 = 10 := by omega
  rcases d11 with e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11 | e11
  · exact nocase319 e5 e7 e11 hall
  · exact nocase320 e5 e7 e11 hall
  · exact nocase321 e5 e7 e11 hall
  · exact nocase322 e5 e7 e11 hall
  · exact nocase323 e5 e7 e11 hall
  · exact nocase324 e5 e7 e11 hall
  · exact nocase325 e5 e7 e11 hall
  · exact nocase326 e5 e7 e11 hall
  · exact nocase327 e5 e7 e11 hall
  · exact nocase328 e5 e7 e11 hall
  · exact nocase329 e5 e7 e11 hall

