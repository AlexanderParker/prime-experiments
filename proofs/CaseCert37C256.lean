def Dg256 (r0 r1 r2 r3 r4 r5 r6 t : ℕ) : ℤ := (if c256_0 r0 t then 1 else 0) + (if c256_1 r1 t then 1 else 0) + (if c256_2 r2 t then 1 else 0) + (if c256_3 r3 t then 1 else 0) + (if c256_4 r4 t then 1 else 0) + (if c256_5 r5 t then 1 else 0) + (if c256_6 r6 t then 1 else 0)
