/-
CounterMachine (round 106, 2026-09-19): the owner's line 3 is independent of the mechanics of
striking - a kernel form of research/proof/fold_mechanic.md (2026-09-11).

A LINE is a multiplicative set of fold survivors (numbers ≡ ±1 mod 6) containing 1.  Its GEARS
are its irreducibles; a gear STRIKES what it divides; its COLUMNS are the pairs (6j-1, 6j+1) with
both members on the line.  Every mechanic the owner's argument uses is a theorem about lines:

  * the square-root rule (`Line.gear_of_rough`): an element below the next gear's square that no
    gear up to `p` divides is a gear;
  * hence a surviving column of a stretch is a twin gear pair (`Line.twin_of_surviving`).

Two lines are models.  The REAL line is all of S = {6j ± 1}; its gears are the primes ≥ 5
(`real_gear_iff`), and its survival statement is exactly `MirrorWalk.SurvivalInf`
(`real_survivalInf_iff`) - the twin prime conjecture (entry 111).  The COUNTER line is the monoid
generated by every prime ≡ 1 mod 6 and every prime ≡ 5 mod 6 whose `+2` is not prime; its gears
are exactly those generators (`counter_gear_iff`), and NO stretch of it ever survives
(`counter_never_survives`).

So the mechanics of striking hold on a line where survival fails at every stretch: survival does
not follow from them.  What the counter line lacks is one thing - its columns are not all of the
`j` - and that is what any proof must use.
-/
import OwnerArgument

namespace CounterMachine

/-- A line: a multiplicative set of fold survivors. -/
structure Line where
  mem : ℕ → Prop
  one_mem : mem 1
  mul_mem : ∀ a b, mem a → mem b → mem (a * b)
  survivor : ∀ n, mem n → n % 6 = 1 ∨ n % 6 = 5

namespace Line

variable (L : Line)

/-- A gear of the line: an irreducible element above 1. -/
def Gear (g : ℕ) : Prop :=
  L.mem g ∧ 1 < g ∧ ∀ a b, L.mem a → L.mem b → g = a * b → a = 1 ∨ b = 1

/-- A column of the line: both members on the line. -/
def Column (j : ℕ) : Prop := L.mem (6 * j - 1) ∧ L.mem (6 * j + 1)

/-- Survival above every bound, for a line: some stretch `(p², q²)` between consecutive gears
holds a column of the line struck by no gear up to `p`. -/
def SurvivalInf : Prop :=
  ∀ N : ℕ, ∃ p q : ℕ, N < p ∧ L.Gear p ∧ 5 ≤ p ∧ L.Gear q ∧ p < q ∧
    (∀ r : ℕ, L.Gear r → p < r → q ≤ r) ∧
    ∃ m : ℕ, p ^ 2 < 6 * m - 1 ∧ 6 * m + 1 < q ^ 2 ∧ L.Column m ∧
      ∀ r : ℕ, L.Gear r → r ≤ p → ¬ (r ∣ 6 * m - 1) ∧ ¬ (r ∣ 6 * m + 1)

variable {L}

/-- Every element of a line above 1 has a gear factor. -/
theorem exists_gear_dvd : ∀ n : ℕ, L.mem n → 1 < n → ∃ g, L.Gear g ∧ g ∣ n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn h1
    by_cases hg : ∀ a b, L.mem a → L.mem b → n = a * b → a = 1 ∨ b = 1
    · exact ⟨n, ⟨hn, h1, hg⟩, dvd_refl n⟩
    · push_neg at hg
      obtain ⟨a, b, ha, hb, hab, ha1, hb1⟩ := hg
      have ha0 : a ≠ 0 := by rintro rfl; simp at hab; omega
      have hb0 : b ≠ 0 := by rintro rfl; simp at hab; omega
      have ha2 : 2 ≤ a := by omega
      have hb2 : 2 ≤ b := by omega
      have halt : a < n := by rw [hab]; nlinarith
      have ha1' : 1 < a := by omega
      obtain ⟨g, hg, hga⟩ := ih a halt ha ha1'
      exact ⟨g, hg, dvd_trans hga ⟨b, hab⟩⟩

/-- **The square-root rule on a line.**  An element below `q²`, where every gear below `q` is at
most `p`, that no gear up to `p` divides, is a gear. -/
theorem gear_of_rough {p q n : ℕ} (hnext : ∀ r : ℕ, L.Gear r → p < r → q ≤ r)
    (hn : L.mem n) (h1 : 1 < n) (hlt : n < q ^ 2)
    (hrough : ∀ r : ℕ, L.Gear r → r ≤ p → ¬ (r ∣ n)) : L.Gear n := by
  refine ⟨hn, h1, ?_⟩
  intro a b ha hb hab
  by_contra hcon
  push_neg at hcon
  obtain ⟨ha1, hb1⟩ := hcon
  have ha0 : a ≠ 0 := by rintro rfl; simp at hab; omega
  have hb0 : b ≠ 0 := by rintro rfl; simp at hab; omega
  -- the smaller factor is below q
  have hmin : ∃ c d, L.mem c ∧ L.mem d ∧ n = c * d ∧ 1 < c ∧ c ^ 2 ≤ n := by
    rcases Nat.le_total a b with h | h
    · exact ⟨a, b, ha, hb, hab, by omega, by rw [hab]; nlinarith⟩
    · exact ⟨b, a, hb, ha, by rw [hab, mul_comm], by omega, by rw [hab]; nlinarith⟩
  obtain ⟨c, d, hc, _, hcd, hc1, hc2⟩ := hmin
  obtain ⟨g, hg, hgc⟩ := exists_gear_dvd c hc hc1
  have hgn : g ∣ n := dvd_trans hgc ⟨d, hcd⟩
  have hgc' : g ≤ c := Nat.le_of_dvd (by omega) hgc
  have hcq : c < q := by
    by_contra h; push_neg at h
    have : q ^ 2 ≤ c ^ 2 := Nat.pow_le_pow_left h 2
    omega
  have hgp : g ≤ p := by
    by_contra h; push_neg at h
    have := hnext g hg h; omega
  exact hrough g hg hgp hgn

/-- **A surviving column is a twin gear pair** - on every line. -/
theorem twin_of_surviving {p q m : ℕ} (hp5 : 5 ≤ p)
    (hnext : ∀ r : ℕ, L.Gear r → p < r → q ≤ r)
    (hlo : p ^ 2 < 6 * m - 1) (hhi : 6 * m + 1 < q ^ 2) (hcol : L.Column m)
    (hopen : ∀ r : ℕ, L.Gear r → r ≤ p → ¬ (r ∣ 6 * m - 1) ∧ ¬ (r ∣ 6 * m + 1)) :
    L.Gear (6 * m - 1) ∧ L.Gear (6 * m + 1) := by
  have h25 : 25 ≤ p ^ 2 := by nlinarith
  constructor
  · exact gear_of_rough hnext hcol.1 (by omega) (by omega) (fun r hr hrp => (hopen r hr hrp).1)
  · exact gear_of_rough hnext hcol.2 (by omega) (by omega) (fun r hr hrp => (hopen r hr hrp).2)

end Line

/-! ### The real line: all of `S = {6j ± 1}` -/

/-- A divisor of a survivor is a survivor. -/
theorem survivor_of_dvd {m g : ℕ} (h : m ∣ g) (hg : g % 6 = 1 ∨ g % 6 = 5) :
    m % 6 = 1 ∨ m % 6 = 5 := by
  by_contra hc
  have h23 : 2 ∣ m ∨ 3 ∣ m := by omega
  rcases h23 with h2 | h3
  · have := dvd_trans h2 h; omega
  · have := dvd_trans h3 h; omega

/-- The real line. -/
def real : Line where
  mem n := n % 6 = 1 ∨ n % 6 = 5
  one_mem := by norm_num
  mul_mem a b ha hb := by
    rw [Nat.mul_mod]
    rcases ha with ha | ha <;> rcases hb with hb | hb <;> rw [ha, hb] <;> norm_num
  survivor n hn := hn

/-- **The real line's gears are the primes at least 5.** -/
theorem real_gear_iff (g : ℕ) : real.Gear g ↔ g.Prime ∧ 5 ≤ g := by
  constructor
  · rintro ⟨hg, h1, hirr⟩
    have hprime : g.Prime := by
      rw [Nat.prime_def]
      refine ⟨by omega, ?_⟩
      intro m hm
      obtain ⟨k, hk⟩ := hm
      have hm' : real.mem m := survivor_of_dvd ⟨k, hk⟩ hg
      have hk' : real.mem k := survivor_of_dvd ⟨m, by rw [hk, mul_comm]⟩ hg
      rcases hirr m k hm' hk' hk with h | h
      · left; exact h
      · right; rw [hk, h, mul_one]
    refine ⟨hprime, ?_⟩
    have hg' : g % 6 = 1 ∨ g % 6 = 5 := hg
    omega
  · rintro ⟨hp, h5⟩
    have hg : g % 6 = 1 ∨ g % 6 = 5 := by
      have h2 : ¬ 2 ∣ g := by
        intro h
        have := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h
        omega
      have h3 : ¬ 3 ∣ g := by
        intro h
        have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp h
        omega
      omega
    refine ⟨hg, hp.one_lt, ?_⟩
    intro a b _ _ hab
    have hdvd : a ∣ g := ⟨b, hab⟩
    rcases (Nat.dvd_prime hp).mp hdvd with h | h
    · left; exact h
    · right
      rw [h] at hab
      have : g * b = g * 1 := by rw [mul_one]; exact hab.symm
      exact Nat.eq_of_mul_eq_mul_left hp.pos this

/-- Every column is a column of the real line. -/
theorem real_column (j : ℕ) (hj : 1 ≤ j) : real.Column j := by
  constructor <;> simp only [real] <;> omega

/-- **The real line's survival statement is the kernel's `SurvivalInf`** - the twin prime
conjecture (entry 111). -/
theorem real_survivalInf_iff : real.SurvivalInf ↔ MirrorWalk.SurvivalInf := by
  constructor
  · intro h N
    obtain ⟨p, q, hpN, hp, hp5, hq, hpq, hnext, m, hlo, hhi, _, hopen⟩ := h N
    have hp' := (real_gear_iff p).mp hp
    have hq' := (real_gear_iff q).mp hq
    refine ⟨p, q, hpN, hp'.1, hp5, hq'.1, hpq, ?_, m, hlo, hhi, ?_⟩
    · intro r hr hpr
      exact hnext r ((real_gear_iff r).mpr ⟨hr, by omega⟩) hpr
    · intro r hr hrp
      by_cases h5 : 5 ≤ r
      · exact hopen r ((real_gear_iff r).mpr ⟨hr, h5⟩) hrp
      · have h2 := hr.two_le
        have h23 : r = 2 ∨ r = 3 := by
          rcases Nat.lt_or_ge r 4 with h4 | h4
          · omega
          · have : r = 4 := by omega
            subst this; norm_num at hr
        have hm1 : 1 ≤ m := by
          by_contra hm; push_neg at hm
          have : m = 0 := by omega
          rw [this] at hlo; simp at hlo
        rcases h23 with rfl | rfl
        · exact ⟨by omega, by omega⟩
        · exact ⟨by omega, by omega⟩
  · intro h N
    obtain ⟨p, q, hpN, hp, hp5, hq, hpq, hnext, m, hlo, hhi, hopen⟩ := h N
    have hm1 : 1 ≤ m := by
      by_contra hm; push_neg at hm
      have : m = 0 := by omega
      rw [this] at hlo; simp at hlo
    refine ⟨p, q, hpN, (real_gear_iff p).mpr ⟨hp, hp5⟩, hp5, (real_gear_iff q).mpr ⟨hq, by omega⟩,
      hpq, ?_, m, hlo, hhi, real_column m hm1, ?_⟩
    · intro r hr hpr
      exact hnext r ((real_gear_iff r).mp hr).1 hpr
    · intro r hr hrp
      exact hopen r ((real_gear_iff r).mp hr).1 hrp

/-! ### The counter line: the twin lowers removed from the generators -/

/-- The generators: every prime ≡ 1 mod 6, and every prime ≡ 5 mod 6 whose `+2` is not prime. -/
def counterGen (g : ℕ) : Prop :=
  g.Prime ∧ (g % 6 = 1 ∨ (g % 6 = 5 ∧ ¬ (g + 2).Prime))

/-- Membership in the monoid the generators produce. -/
inductive counterMem : ℕ → Prop
  | one : counterMem 1
  | gen {g : ℕ} : counterGen g → counterMem g
  | mul {a b : ℕ} : counterMem a → counterMem b → counterMem (a * b)

theorem counterGen_survivor {g : ℕ} (h : counterGen g) : g % 6 = 1 ∨ g % 6 = 5 := by
  rcases h.2 with h1 | h5
  · left; exact h1
  · right; exact h5.1

theorem counterMem_survivor : ∀ n, counterMem n → n % 6 = 1 ∨ n % 6 = 5 := by
  intro n hn
  induction hn with
  | one => norm_num
  | gen h => exact counterGen_survivor h
  | mul _ _ iha ihb =>
    rw [Nat.mul_mod]
    rcases iha with ha | ha <;> rcases ihb with hb | hb <;> rw [ha, hb] <;> norm_num

/-- The counter line. -/
def counter : Line where
  mem := counterMem
  one_mem := counterMem.one
  mul_mem _ _ ha hb := counterMem.mul ha hb
  survivor := counterMem_survivor

/-- **The counter line's gears are exactly its generators.** -/
theorem counter_gear_iff (g : ℕ) : counter.Gear g ↔ counterGen g := by
  constructor
  · rintro ⟨hg, h1, hirr⟩
    -- an irreducible of the monoid is a generator
    have key : ∀ n, counterMem n → 1 < n →
        (∀ a b, counterMem a → counterMem b → n = a * b → a = 1 ∨ b = 1) → counterGen n := by
      intro n hn
      induction hn with
      | one => intro h; omega
      | gen h => intro _ _; exact h
      | @mul a b ha hb iha ihb =>
        intro h1 hirr
        rcases hirr a b ha hb rfl with h | h
        · subst h
          rw [one_mul] at h1 hirr ⊢
          exact ihb h1 hirr
        · subst h
          rw [mul_one] at h1 hirr ⊢
          exact iha h1 hirr
    exact key g hg h1 hirr
  · intro h
    refine ⟨counterMem.gen h, h.1.one_lt, ?_⟩
    intro a b _ _ hab
    have hdvd : a ∣ g := ⟨b, hab⟩
    rcases (Nat.dvd_prime h.1).mp hdvd with h' | h'
    · left; exact h'
    · right
      rw [h'] at hab
      have : g * b = g * 1 := by rw [mul_one]; exact hab.symm
      exact Nat.eq_of_mul_eq_mul_left h.1.pos this

/-- **No stretch of the counter line ever survives**: a surviving column would be a twin gear
pair, i.e. twin primes whose lower member is a generator - and the lower member of a twin pair is
never a generator. -/
theorem counter_never_survives {p q m : ℕ} (hp5 : 5 ≤ p)
    (hnext : ∀ r : ℕ, counter.Gear r → p < r → q ≤ r)
    (hlo : p ^ 2 < 6 * m - 1) (hhi : 6 * m + 1 < q ^ 2) (hcol : counter.Column m)
    (hopen : ∀ r : ℕ, counter.Gear r → r ≤ p → ¬ (r ∣ 6 * m - 1) ∧ ¬ (r ∣ 6 * m + 1)) :
    False := by
  obtain ⟨h1, h2⟩ := Line.twin_of_surviving hp5 hnext hlo hhi hcol hopen
  have g1 := (counter_gear_iff _).mp h1
  have g2 := (counter_gear_iff _).mp h2
  have hm1 : 1 ≤ m := by
    by_contra hm; push_neg at hm
    have : m = 0 := by omega
    rw [this] at hlo; simp at hlo
  have hmod : (6 * m - 1) % 6 = 5 := by omega
  rcases g1.2 with h | h
  · omega
  · apply h.2
    have : 6 * m - 1 + 2 = 6 * m + 1 := by omega
    rw [this]; exact g2.1

/-- **Survival is independent of the mechanics**: the counter line satisfies every axiom of a
line, and its survival statement is false. -/
theorem counter_not_survivalInf : ¬ counter.SurvivalInf := by
  intro h
  obtain ⟨p, q, _, _, hp5, _, _, hnext, m, hlo, hhi, hcol, hopen⟩ := h 0
  exact counter_never_survives hp5 hnext hlo hhi hcol hopen

end CounterMachine
